# Copy this file to .env and fill in real values. .env itself is gitignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FLASK_SECRET_KEY=
MONGO_URI=
MAIL_USERNAME=
MAIL_PASSWORD=

# Comma-separated frontend origins allowed to call the API, e.g.:
# http://localhost:8080,https://your-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:8080
